{
    "openapi": "3.0.0",
    "info": {
        "title": "Card Collector API",
        "version": "1.0.0",
        "description": "API for the Card Collector application."
    },
    "paths": {
        "/collections": {
            "get": {
                "summary": "List all collections",
                "operationId": "listCollections",
                "responses": {
                    "200": {
                        "description": "An array of collections",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Collection"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Card": {
                "type": "object",
                "required": [
                    "id",
                    "setId",
                    "set",
                    "name",
                    "number"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64",
                        "description": "Auto-incrementing unique ID for the card"
                    },
                    "setId": {
                        "type": "integer",
                        "format": "int64",
                        "description": "Reference to the set by its unique ID",
                        "x-relationship": {
                            "type": "belongsTo",
                            "target": "#/components/schemas/Set",
                            "targetKey": "id"
                        }
                    },
                    "set": {
                        "type": "string",
                        "description": "The set this card belongs to"
                    },
                    "name": {
                        "type": "string",
                        "description": "The name of this card"
                    },
                    "number": {
                        "type": "integer",
                        "description": "The number of this card in the set"
                    }
                }
            },
            "Set": {
                "type": "object",
                "required": [
                    "id",
                    "collectionId",
                    "name"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64",
                        "description": "Auto-incrementing unique ID for the set"
                    },
                    "collectionId": {
                        "type": "integer",
                        "format": "int64",
                        "description": "Reference to the collection by its unique ID",
                        "x-relationship": {
                            "type": "belongsTo",
                            "target": "#/components/schemas/Collection",
                            "targetKey": "id"
                        }
                    },
                    "name": {
                        "type": "string",
                        "description": "The name of this set"
                    },
                    "cards": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Card"
                        },
                        "description": "The cards in this set"
                    }
                }
            },
            "Collection": {
                "type": "object",
                "required": [
                    "id",
                    "name"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64",
                        "description": "Auto-incrementing unique ID for the collection"
                    },
                    "name": {
                        "type": "string",
                        "description": "The name of this collection"
                    },
                    "sets": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Set"
                        },
                        "description": "The sets in this collection"
                    }
                }
            }
        }
    }
}
