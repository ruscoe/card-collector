{
    "openapi": "3.0.0",
    "info": {
        "title": "Card Collector API",
        "version": "1.0.0",
        "description": "API for the Card Collector application."
    },
    "paths": {
        "/collections": {
            "get": {
                "summary": "List all collections",
                "operationId": "listCollections",
                "responses": {
                    "200": {
                        "description": "An array of collections",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Collection"
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "summary": "Create a new collection",
                "operationId": "createCollection",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "name"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "description": "The name of the collection"
                                    },
                                    "sets": {
                                        "type": "array",
                                        "items": {
                                            "$ref": "#/components/schemas/Set"
                                        },
                                        "description": "Optional sets included with the new collection"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "The created collection",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Collection"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid request payload"
                    }
                }
            }
        },
        "/collections/{collectionId}": {
            "delete": {
                "summary": "Delete a collection",
                "operationId": "deleteCollection",
                "parameters": [
                    {
                        "name": "collectionId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int64"
                        },
                        "description": "The unique ID of the collection to delete"
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Collection deleted successfully"
                    },
                    "404": {
                        "description": "Collection not found"
                    }
                }
            }
        },
        "/collections/{collectionId}/sets": {
            "get": {
                "summary": "List all sets in a collection",
                "operationId": "listSetsByCollection",
                "parameters": [
                    {
                        "name": "collectionId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int64"
                        },
                        "description": "The unique ID of the collection"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "An array of sets in the specified collection",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Set"
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Collection not found"
                    }
                }
            }
        },
        "/sets": {
            "post": {
                "summary": "Create a new set",
                "operationId": "createSet",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "name",
                                    "collectionId"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "description": "The name of the set"
                                    },
                                    "collectionId": {
                                        "type": "integer",
                                        "format": "int64",
                                        "description": "The ID of the collection this set belongs to"
                                    },
                                    "cards": {
                                        "type": "array",
                                        "items": {
                                            "$ref": "#/components/schemas/Card"
                                        },
                                        "description": "Optional cards included with the new set"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "The created set",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Set"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid request payload"
                    },
                    "404": {
                        "description": "Collection not found"
                    }
                }
            }
        },
        "/sets/{setId}": {
            "delete": {
                "summary": "Delete a set",
                "operationId": "deleteSet",
                "parameters": [
                    {
                        "name": "setId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int64"
                        },
                        "description": "The unique ID of the set to delete"
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Set deleted successfully"
                    },
                    "404": {
                        "description": "Set not found"
                    }
                }
            }
        },
        "/cards": {
            "post": {
                "summary": "Create a new card",
                "operationId": "createCard",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "name",
                                    "setId",
                                    "number"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "description": "The name of the card"
                                    },
                                    "setId": {
                                        "type": "integer",
                                        "format": "int64",
                                        "description": "The ID of the set this card belongs to"
                                    },
                                    "number": {
                                        "type": "integer",
                                        "description": "The number of this card in the set"
                                    },
                                    "set": {
                                        "type": "string",
                                        "description": "The name of the set this card belongs to"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "The created card",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Card"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid request payload"
                    },
                    "404": {
                        "description": "Set not found"
                    }
                }
            }
        },
        "/cards/{cardId}": {
            "delete": {
                "summary": "Delete a card",
                "operationId": "deleteCard",
                "parameters": [
                    {
                        "name": "cardId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int64"
                        },
                        "description": "The unique ID of the card to delete"
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Card deleted successfully"
                    },
                    "404": {
                        "description": "Card not found"
                    }
                }
            }
        },
        "/sets/{setId}/cards": {
            "get": {
                "summary": "List all cards in a set",
                "operationId": "listCardsBySet",
                "parameters": [
                    {
                        "name": "setId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int64"
                        },
                        "description": "The unique ID of the set"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "An array of cards in the specified set",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Card"
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Set not found"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Card": {
                "type": "object",
                "required": [
                    "id",
                    "setId",
                    "set",
                    "name",
                    "number"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64",
                        "description": "Auto-incrementing unique ID for the card"
                    },
                    "setId": {
                        "type": "integer",
                        "format": "int64",
                        "description": "Reference to the set by its unique ID",
                        "x-relationship": {
                            "type": "belongsTo",
                            "target": "#/components/schemas/Set",
                            "targetKey": "id"
                        }
                    },
                    "set": {
                        "type": "string",
                        "description": "The set this card belongs to"
                    },
                    "name": {
                        "type": "string",
                        "description": "The name of this card"
                    },
                    "number": {
                        "type": "integer",
                        "description": "The number of this card in the set"
                    }
                }
            },
            "Set": {
                "type": "object",
                "required": [
                    "id",
                    "collectionId",
                    "name"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64",
                        "description": "Auto-incrementing unique ID for the set"
                    },
                    "collectionId": {
                        "type": "integer",
                        "format": "int64",
                        "description": "Reference to the collection by its unique ID",
                        "x-relationship": {
                            "type": "belongsTo",
                            "target": "#/components/schemas/Collection",
                            "targetKey": "id"
                        }
                    },
                    "name": {
                        "type": "string",
                        "description": "The name of this set"
                    },
                    "cards": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Card"
                        },
                        "description": "The cards in this set"
                    }
                }
            },
            "Collection": {
                "type": "object",
                "required": [
                    "id",
                    "name"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64",
                        "description": "Auto-incrementing unique ID for the collection"
                    },
                    "name": {
                        "type": "string",
                        "description": "The name of this collection"
                    },
                    "sets": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Set"
                        },
                        "description": "The sets in this collection"
                    }
                }
            }
        }
    }
}
